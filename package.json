{
  "name": "intersearch",
  "version": "0.1.0",
  "private": true,
  "description": "Personal internship research dashboard: tracker agent, researcher and verifier services (NYU FNMS A1, 1B, 2)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend && npm run prisma:generate --prefix backend && node scripts/setup-env.mjs",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:researcher": "npm run dev:researcher --prefix backend",
    "dev:verifier": "npm run dev:verifier --prefix backend",
    "dev:all": "node scripts/dev-all.mjs",
    "demo": "node scripts/dev-all.mjs --demo",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "tracker:config": "npm run tracker --prefix backend -- config",
    "tracker:run": "npm run tracker --silent --prefix backend -- run",
    "tracker:export": "npm run tracker --prefix backend -- export",
    "tracker:handcheck": "npm run tracker --prefix backend -- handcheck",
    "tracker:reset": "npm run tracker --prefix backend -- reset",
    "tracker:tools": "npm run tools --silent --prefix backend --",
    "contract-check": "npm run contract-check --silent --prefix backend --",
    "test:unit": "npm run test:unit --prefix backend",
    "test:integration": "npm run test:integration --prefix backend",
    "typecheck": "npm run typecheck --prefix backend && npm run typecheck --prefix frontend",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "verify": "node scripts/verify.mjs"
  }
}
